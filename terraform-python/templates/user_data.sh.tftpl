#!/bin/bash
set -eux

# EC2 初回起動時に実行されるスクリプトです。
# Terraform の templatefile から呼ばれ、CORSやSQLiteパスなどに実際の値が埋め込まれます。

# OS パッケージを更新します。
dnf update -y

# FastAPI アプリを動かすために Python を入れます。
dnf install -y python3 python3-pip

# アプリ本体と設定ファイルを置くディレクトリを作ります。
mkdir -p /opt/wordch/server-python /etc/wordch
mkdir -p "$(dirname '${sqlite_path}')"

# FastAPI に渡す環境変数をファイルに書きます。
# systemd service から EnvironmentFile として読み込まれます。
cat >/etc/wordch/wordch.env <<'ENV'
CORS_ALLOWED_ORIGINS=${cors_allowed_origins}
WORDCH_SQLITE_PATH=${sqlite_path}
ENV

# root だけが書き換えられる権限にします。
chmod 600 /etc/wordch/wordch.env

# SQLite DB を保存するディレクトリを service user から読めるようにします。
chmod 755 "$(dirname '${sqlite_path}')"

# FastAPI アプリを systemd service として登録します。
# /opt/wordch/server-python は、この後のデプロイ手順で配置します。
cat >/etc/systemd/system/wordch.service <<'SERVICE'
[Unit]
Description=wordch API application
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/wordch/wordch.env
WorkingDirectory=/opt/wordch/server-python
ExecStart=/opt/wordch/server-python/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
SERVICE

# systemd に新しい service ファイルを読み込ませます。
systemctl daemon-reload

# EC2 再起動時にも wordch service が起動するように有効化します。
# アプリコードはまだ置かれていないため、ここでは start せず enable だけにしています。
systemctl enable wordch
