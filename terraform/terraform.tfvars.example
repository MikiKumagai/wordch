aws_region = "ap-northeast-3"

# Replace with a narrow CIDR such as your current global IP plus /32.
ssh_allowed_cidr = "203.0.113.10/32"

# Public while the S3 website talks directly to the API.
app_allowed_cidr = "0.0.0.0/0"

# Optional: existing EC2 key pair name.
key_name = "wordch"

db_username = "kmmk"
