#!/bin/bash
set -eux

dnf update -y
dnf install -y java-17-amazon-corretto-headless

mkdir -p /opt/wordch /etc/wordch

cat >/etc/wordch/wordch.env <<'ENV'
SPRING_PROFILES_ACTIVE=prd
SPRING_DATASOURCE_URL=jdbc:postgresql://${db_host}:5432/${db_name}
SPRING_DATASOURCE_USERNAME=${db_username}
SPRING_DATASOURCE_PASSWORD=${db_password}
CORS_ALLOWED_ORIGINS=${cors_allowed_origins}
ENV

chmod 600 /etc/wordch/wordch.env

cat >/etc/systemd/system/wordch.service <<'SERVICE'
[Unit]
Description=wordch API application
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/wordch/wordch.env
ExecStart=/usr/bin/java -jar /opt/wordch/wordch.jar
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable wordch
